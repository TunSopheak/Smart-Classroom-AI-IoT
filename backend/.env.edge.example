# Copy this file to backend/.env.edge and fill values locally.
# Never commit backend/.env.edge or share its Device Key.

SMART_CLASSROOM_EDGE_API_URL=https://smart-classroom-ai-iot.onrender.com
SMART_CLASSROOM_DEVICE_API_KEY=replace-with-render-device-key
SMART_CLASSROOM_EDGE_DEVICE_ID=classroom-laptop-01

SMART_CLASSROOM_EDGE_CAMERA_INDEX=0
SMART_CLASSROOM_EDGE_SHOW_WINDOW=true
SMART_CLASSROOM_EDGE_FACE_CONFIDENCE=0.60
SMART_CLASSROOM_EDGE_STABLE_FRAMES=6
SMART_CLASSROOM_EDGE_UNKNOWN_MAX_CONFIDENCE=0.45
SMART_CLASSROOM_EDGE_UNKNOWN_STABLE_FRAMES=6
SMART_CLASSROOM_EDGE_OBJECT_EVERY_N_FRAMES=5
SMART_CLASSROOM_EDGE_CONTEXT_REFRESH_SECONDS=15
SMART_CLASSROOM_EDGE_HEARTBEAT_SECONDS=30
SMART_CLASSROOM_EDGE_EVENT_COOLDOWN_SECONDS=30
SMART_CLASSROOM_EDGE_API_TIMEOUT_SECONDS=15
